# ─── Next.js public env vars (exposed to browser) ────────────────────────────
# Must be prefixed with NEXT_PUBLIC_

# Site canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://among.io

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase client SDK config
# Found in: Firebase Console → Project Settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# Socket.IO connection URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
