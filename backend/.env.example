# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/among_dev
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/among?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/among_dev

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Found in: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value here (keep the \n characters, do NOT replace them)
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | http | debug
LOG_LEVEL=info

# ─── Rate limiting (in-memory, resets on server restart) ──────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
