{
  "name": "among-backend",
  "version": "1.0.0",
  "description": "AMONG — Express.js + Socket.IO backend",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "mongoose": "^8.6.1",
    "socket.io": "^4.7.5",
    "firebase-admin": "^12.3.1",
    "ioredis": "^5.4.1",
    "agenda": "^5.0.0",
    "zod": "^3.23.8",
    "winston": "^3.14.2",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ms": "^0.7.34",
    "@types/jest": "^29.5.13",
    "@types/supertest": "^6.0.2",
    "@types/node": "^22.5.5",
    "typescript": "^5.6.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "supertest": "^7.0.0",
    "jest": "^29.7.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "eslint": "^9.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
